{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "outDir": "out",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"]
    }
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/renderer/**/*", "electron.vite.config.ts", "test/**/*", "vitest.config.ts"]
}
