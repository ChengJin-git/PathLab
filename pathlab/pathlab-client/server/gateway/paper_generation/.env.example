# Paper-generation dev relay configuration.
#
# Copy this file to `.env` (gitignored) and `source` it before running tests
# / starting the gateway in dev. These three vars together activate the
# paper-gen LLM provider's "relay override" — it bypasses PathLab's main
# OpenRouter/vLLM settings without touching the chat assistant config.
#
# Pulled from `~/.codex/config.toml` + `~/.codex/auth.json` for personal dev.
# Never commit a real key.

# Highest-precedence override; if all three are set, the LLM provider routes
# all calls through this relay regardless of PathLab Settings.
export PAPER_GEN_LLM_BASE_URL="https://relay.1hui.wang/openai/v1"
export PAPER_GEN_LLM_API_KEY="cr_REPLACE_WITH_KEY_FROM_~/.codex/auth.json"

# Pick a model the relay supports. As of 2026-05:
#   gpt-5.5            — reasoning, requires stream=true (we always stream)
#   gpt-5.4            — reasoning
#   claude-haiku-4-5   — non-reasoning, fastest + cheapest
# (Lighter models like gpt-4o-mini / gpt-5-mini are NOT supported on this relay.)
export PAPER_GEN_LLM_MODEL="claude-haiku-4-5"
