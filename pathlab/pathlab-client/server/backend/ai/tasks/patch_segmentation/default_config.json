{
  "bs": 64,
  "epochs": 30,
  "device": "cuda:1",
  "save_dir": "/storage/jmabq/data/DSCC/outputs",
  "model_dtype": "FLOAT32",

  "scheduler": {
    "total_iter": 40000,
    "type": "WarmupOneCycleLR",
    "constructor_kwargs": {
      "warmup_iters": 1500,
      "warmup_ratio": 1e-6,
      "final_div_factor": 25,
      "pct_start": 0,
      "anneal_strategy": "cos",
      "use_beta1": false,
      "update_momentum": false
    }
  },
  "optimizer": {
    "lr": 0.001,
    "beta1": 0.9,
    "beta2": 0.999,
    "weight_decay": 0.001,
    "gradient_clip": "inf"
  },
  "dataset": {
    "image_root": "/storage/jmabq/data/DSCC",
    "train": 0.7,
    "val": 0.1,
    "test": 0.2,
    "single_annotation_path": null,
    "train_annotation_path": "/storage/jmabq/data/DSCC/seg/train.json",
    "val_annotation_path": "/storage/jmabq/data/DSCC/seg/val.json",
    "test_annotation_path": "/storage/jmabq/data/DSCC/seg/test.json"
  },

  "train": {
    "diceloss_weight": 0.0,
    "celoss_weight": 1.0
  },
  "model": {
    "backbone": "vit_large_patch16_dinov3",
    "type": "linear",
    "backbone_out_layers": "FOUR_EVEN_INTERVALS",
    "use_cls_token": false,
    "use_batchnorm": true,
    "use_backbone_norm": true,
    "num_classes": 150,
    "hf_token": ""
  },
  "transforms": {
    "train": {
      "img_size": 512,
      "random_img_size_ratio_range": [0.5, 2.0],
      "crop_size": [512, 512],
      "flip_prob": 0.5
    },
    "eval": {
      "img_size": 512
    }
  },
  "eval": {
    "compute_metric_per_image": false,
    "reduce_zero_label": true,
    "mode": "slide",
    "crop_size": 512,
    "stride": 341,
    "eval_interval": 5000,
    "use_tta": false,
    "metric_to_save": "mIoU"
  }
}