                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePaperRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "paper_type": {
            "type": "string",
            "title": "Paper Type",
            "default": "research_paper"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "en"
          },
          "source_tasks": {
            "items": {
              "$ref": "#/components/schemas/SourceTaskRef"
            },
            "type": "array",
            "title": "Source Tasks"
          },
          "selected_templates": {
            "items": {
              "$ref": "#/components/schemas/TemplateId"
            },
            "type": "array",
            "title": "Selected Templates",
            "description": "User-selected target template. The public API expects exactly one template per paper-writing run."
          },
          "include_external_validation": {
            "type": "boolean",
            "title": "Include External Validation",
            "default": true
          },
          "user_idea": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Idea",
            "description": "User-provided idea.md content. If absent the agent must prompt the user before invoking any LLM."
          }
        },
        "type": "object",
        "title": "CreatePaperRequest",
        "description": "POST /papers body."
      },
      "GuardIssueSummary": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "severity": {
            "type": "string",
            "title": "Severity",
            "default": "error"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "GuardIssueSummary",
        "description": "Public-safe preview of one guard issue."
      },
      "GuardResultSummary": {
        "properties": {
          "guard": {
            "type": "string",
            "title": "Guard"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "not_run"
          },
          "issue_count": {
            "type": "integer",
            "title": "Issue Count",
            "default": 0
          },
          "error_count": {
            "type": "integer",
            "title": "Error Count",
            "default": 0
          },
          "warning_count": {
            "type": "integer",
            "title": "Warning Count",
            "default": 0
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "sample_issues": {
            "items": {
              "$ref": "#/components/schemas/GuardIssueSummary"
            },
            "type": "array",
            "title": "Sample Issues"
          }
        },
        "type": "object",
        "required": [
          "guard"
        ],
        "title": "GuardResultSummary",
        "description": "Compact validation guard status for the frontend."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaperRunArtifact": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ready"
          },
          "visibility": {
            "type": "string",
            "title": "Visibility",
            "default": "public"
          },
          "downloadable": {
            "type": "boolean",
            "title": "Downloadable",
            "default": true
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "PaperRunArtifact",
        "description": "Public artifact metadata shown in the UI."
      },
