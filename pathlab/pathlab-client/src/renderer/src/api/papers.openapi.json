        ],
        "summary": "Download Paper File",
        "operationId": "download_paper_file_papers__paper_id__files__path__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "paper_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
