            "title": "Created At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/PaperRunArtifact"
            },
            "type": "array",
            "title": "Artifacts"
          },
          "stage_log": {
