        "type": "object",
        "required": [
          "paper_id",
          "status",
          "current_stage",
          "title",
          "selected_templates",
          "source_task_ids",
          "created_at",
          "finished_at",
          "error_message"
        ],
        "title": "PaperRunDetail",
        "description": "Detailed run view returned by GET /papers/{id}."
      },
      "PaperRunListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PaperRunSummary"
            },
            "type": "array",
            "title": "Items"
