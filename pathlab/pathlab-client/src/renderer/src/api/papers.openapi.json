            "type": "string",
            "title": "Paper Id"
          },
          "status": {
            "$ref": "#/components/schemas/PaperRunStatus",
            "default": "pending"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "Paper run accepted; processing in background."
          }
        },
        "type": "object",
        "required": [
          "paper_id"
        ],
        "title": "PaperRunCreateResponse"
      },
      "PaperRunDetail": {
        "properties": {
          "paper_id": {
            "type": "string",
            "title": "Paper Id"
          },
          "status": {
