          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "PaperRunListResponse"
      },
      "PaperRunStage": {
        "type": "string",
        "enum": [
          "created",
          "collecting",
          "building_evidence",
          "outlining",
          "plotting",
          "literature_review",
          "section_writing",
          "validating",
          "refining",
          "rendering",
          "exporting",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "PaperRunStage",
        "description": "Pipeline stage labels used by manifest and front-end polling.\n\nThese names intentionally mirror the Phase 01 plan state machine so the\nstandalone paper agent and Gateway do not drift."
      },
      "PaperRunStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "PaperRunStatus"
      },
      "PaperRunSummary": {
        "properties": {
          "paper_id": {
            "type": "string",
            "title": "Paper Id"
          },
          "status": {
            "$ref": "#/components/schemas/PaperRunStatus"
          },
          "current_stage": {
            "$ref": "#/components/schemas/PaperRunStage"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "selected_templates": {
            "items": {
              "$ref": "#/components/schemas/TemplateId"
            },
            "type": "array",
            "title": "Selected Templates"
          },
          "source_task_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Task Ids"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          }
        },
        "type": "object",
        "required": [
          "paper_id",
          "status",
          "current_stage",
          "title",
          "selected_templates",
          "source_task_ids",
          "created_at",
          "finished_at",
          "error_message"
