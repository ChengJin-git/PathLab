# Frontend Environment Variables Example
# Copy this file to .env.development or .env.production and update the values

# Base path for the application
VITE_BASE_PATH=/

# API endpoints
VITE_API_BASE=http://127.0.0.1:6100
VITE_AI_BASE=http://127.0.0.1:6102/api/ai
VITE_PREPROCESSING_BASE=http://127.0.0.1:6101

# SECURITY: Must match APP_SALT in the backend .env. Changing this invalidates all existing sessions.
# VITE_APP_SALT=PathLab2024SecureSalt