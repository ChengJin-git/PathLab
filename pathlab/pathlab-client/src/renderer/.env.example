# Frontend Environment Variables Example
# Copy this file to .env.development for local development

# Auto-login configuration (for testing)
# Set to 'true' to enable automatic login in development mode
# Default: enabled in development mode (can be disabled with 'false')
VITE_AUTO_LOGIN=true

# Test user credentials (for auto-login)
# These are only used in development/test environments
VITE_TEST_USERNAME=admin
VITE_TEST_PASSWORD=Smartlab2022

# API Configuration (optional - usually auto-discovered via Electron IPC)
# VITE_API_BASE=http://127.0.0.1:6100
# VITE_PREPROCESSING_BASE=http://127.0.0.1:6101
# VITE_AI_BASE=http://127.0.0.1:6102/api/ai
