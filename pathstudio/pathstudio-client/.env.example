# PathStudio example environment variables (do not commit real secrets)
INTERNAL_API_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
PATHSTUDIO_BASE_PATH=/PathStudio/

# OpenRouter AI Configuration (Optional - for development/testing only)
# IMPORTANT: Users should configure their API key in the Settings page, not here.
# These values are only used as fallback defaults if not provided via Settings.
# Get your API key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# Database Configuration
DATABASE_URL=postgresql+asyncpg://pathstudio:pathstudio@localhost:5432/pathstudio

# Service URLs (for internal communication)
AI_SERVICE_URL=http://127.0.0.1:6102
PREPROCESSING_SERVICE_URL=http://127.0.0.1:6101

