# Copy to <autoresearch storage>/credentials/skills.env, chmod 600.
# These optional credentials are read when starting an agent or computation job.
# Existing text-model Settings and Hugging Face settings remain separate.
PUBMED_EMAIL=
NCBI_API_KEY=
UNPAYWALL_EMAIL=
PADDLE_OCR_TOKEN=
# Image2PPT image generation (not the normal manuscript text model):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE2PPT_IMAGE_BACKEND=openai-compatible-api
IMAGE2PPT_IMAGE_MODEL=gpt-image-2
