# PathLab Python Backend Service
# Deploy to: /etc/systemd/system/pathlab.service
#
# TODO: Before deploying, replace the following:
#   - YOUR_USER: your username
#   - /path/to/pathlab-client: actual path to pathlab-client directory
#   - /home/YOUR_USER/.local/share/PathLab: installed runtime data directory
#   - /path/to/pathlab-client (in EnvironmentFile line): same as above
#
# Commands:
#   sudo systemctl daemon-reload
#   sudo systemctl enable pathlab
#   sudo systemctl start pathlab
#   sudo systemctl status pathlab
#   journalctl -u pathlab -f

[Unit]
Description=PathLab Backend (Gateway + Preprocessing + AI + TaskWorker + ResearchWorker)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/path/to/pathlab-client/server

# Environment variables
Environment="GATEWAY_PORT=6100"
Environment="PREPROCESSING_PORT=6101"
Environment="AI_PORT=6102"
EnvironmentFile=-/path/to/pathlab-client/server/.env
Environment="DATABASE_URL=postgresql+asyncpg://pathlab:pathlab@localhost:5432/pathlab"

# Set these from the installed venv's pathlab.env (without 'export').
Environment="PATHLAB_OPENCODE_BIN=/home/YOUR_USER/.local/share/PathLab/venvs/1.0.8/pathlab-runtime/opencode"
Environment="AUTORESEARCH_SANDBOX_IMAGE=/home/YOUR_USER/.local/share/PathLab/runtime-bundles/runtime-1.0.8-2026-11-01/sandbox.sif"
Environment="APPTAINER_BIN=/usr/bin/apptainer"
ExecStartPre=/home/YOUR_USER/.local/share/PathLab/venvs/1.0.8/bin/python /path/to/pathlab-client/deploy/verify-runtime.py
ExecStart=/home/YOUR_USER/.local/share/PathLab/venvs/1.0.8/bin/python main.py

# Restart policy
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pathlab

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
