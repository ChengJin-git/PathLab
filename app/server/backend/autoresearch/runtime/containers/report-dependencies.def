Bootstrap: localimage
From: {{ base_image }}

%labels
    PathLabReportDependencies "2026-10-29"

%post
    set -eu
    python -m pip install --no-cache-dir --no-deps 'tabulate==0.9.0'

%test
    python - <<'PY'
import pandas as pd
import tabulate
import torch
assert tabulate.__version__ == '0.9.0'
table = pd.DataFrame({'method': ['baseline'], 'auc': [0.81]}).to_markdown(index=False)
assert 'baseline' in table and '0.81' in table
print('pandas Markdown export passed; torch', torch.__version__)
PY
