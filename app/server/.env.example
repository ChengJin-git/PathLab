# PathLab — copy to server/.env and set installation-specific values.
# Keep this shell-compatible: deploy scripts source it; never commit real secrets.
DATABASE_URL=postgresql+asyncpg://pathlab:CHANGE_ME@127.0.0.1:5432/pathlab
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
GATEWAY_PORT=6100
PREPROCESSING_PORT=6101
AI_PORT=6102

# Use an absolute, writable path outside the source checkout.
# PATHLAB_UPLOADS_DIR=/srv/pathlab/uploads

# Python interpreter, OpenCode binary and research sandbox (see docs/installation.md).
# PATHLAB_PYTHON=/home/USER/.local/share/PathLab/venv/bin/python
# PATHLAB_OPENCODE_BIN=/home/USER/.opencode/bin/opencode
# AUTORESEARCH_SANDBOX_IMAGE=/home/USER/.local/share/PathLab/sandbox/pathlab-sandbox.sif
# APPTAINER_BIN=/usr/bin/apptainer
# OpenCode is pinned to 2.4.2; deploy/install-opencode.py verifies the download.
# The research sandbox uses Apptainer by default; set docker to use Docker instead.
# PATHLAB_SANDBOX_BACKEND=docker
# PATHLAB_DOCKER_IMAGE=pathlab/sandbox:1.0.8-r3-cpu
# PATHLAB_DOCKER_MEMORY=6g
# PATHLAB_DOCKER_CPUS=4
# CUDA_VISIBLE_DEVICES=0,1
# PREPROCESSING_WORKERS=4

# Contact address of this installation: shown on the sign-in legal pages and the password
# dialog, and sent to NCBI, Crossref and Unpaywall when articles are fetched (Unpaywall is
# skipped while it is unset).
# PATHLAB_CONTACT_EMAIL=you@example.org

# Configure LLM endpoint/key/model and Hugging Face access in PathLab Settings.
# Optional scientific service keys: deploy/research-skills.env.example.
