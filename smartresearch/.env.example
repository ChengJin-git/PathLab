# SmartResearch example environment variables (do not commit real secrets)
INTERNAL_API_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
SMARTRESEARCH_BASE_PATH=/SmartResearch/

# SiliconFlow AI Configuration (Optional - for development/testing only)
# IMPORTANT: Users should configure their API key in the Settings page, not here.
# These values are only used as fallback defaults if not provided via Settings.
# Get your API key from: https://cloud.siliconflow.cn/account/ak
# SILICONFLOW_API_KEY=sk-your-api-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct

# Database Configuration
DATABASE_URL=postgresql+asyncpg://smartresearch:smartresearch@localhost:5432/smartresearch

# Service URLs (for internal communication)
AI_SERVICE_URL=http://127.0.0.1:6102
PREPROCESSING_SERVICE_URL=http://127.0.0.1:6101
# Backward compatibility (deprecated, use PREPROCESSING_SERVICE_URL)
WSI_SERVICE_URL=http://127.0.0.1:6101

